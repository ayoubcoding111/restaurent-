DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=restaurant_db
PORT=3000

# Public URL of the app (used to build password-reset links)
APP_URL=http://localhost:3000

# Frontend origin for CORS (must match the URL the browser visits)
CLIENT_URL=http://localhost:3000

# Default admin seeding for FIRST setup only (never overwrites existing DB accounts)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@delicious-restaurant.com
ADMIN_PASSWORD=change-me-after-first-login

# --- Real email sending (SMTP) ---
# Example for Gmail: host=smtp.gmail.com port=587 secure=false
# Use a Gmail "App Password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Delicious Restaurant <you@gmail.com>

# --- Login hardening (per-account lockout + IP ban) ---
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15
LOGIN_IP_MAX_FAILS=20
LOGIN_IP_BAN_MIN=60
